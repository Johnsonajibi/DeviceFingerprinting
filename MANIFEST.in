include README.md
include LICENSE
include CHANGELOG.md
include SECURITY.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include pyproject.toml

# Include package data (package lives under src/, not the repo root -
# "graft device_fingerprinting" without the src/ prefix silently matched
# nothing on every build)
graft src/device_fingerprinting

# Exclude unnecessary files
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .git
global-exclude .gitignore
global-exclude .pre-commit-config.yaml
global-exclude *.log
global-exclude *.tmp
global-exclude *.bak
global-exclude *.swp
global-exclude .DS_Store
global-exclude .vscode
global-exclude .idea

# Exclude test files from distribution
prune tests
prune docs
prune examples
prune .github
